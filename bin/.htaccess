# ==============================================================
#  Panel Magazynu - ochrona katalogów
# ==============================================================

# Blokuj dostęp do katalogów z kodem i konfiguracją
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Nie listuj zawartości katalogu
Options -Indexes

# Blokuj wykonywanie skryptów PHP z tego katalogu (dla bezpieczeństwa)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
