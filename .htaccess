# ==============================================================
#  Panel Magazynu - ochrona katalogu glownego
# ==============================================================

# Nie listuj zawartosci katalogu (zamiast spisu plikow pokaze 403)
Options -Indexes

# Nie udostepniaj wrazliwych rodzajow plikow, gdyby trafily do katalogu
<FilesMatch "\.(sql|bak|log|ini|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
